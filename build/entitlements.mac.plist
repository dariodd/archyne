<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the hardened runtime.

  `hardenedRuntime: true` in electron-builder.yml turns off, among other
  things, the memory protections V8 depends on. Chromium's JIT writes
  executable pages at runtime and its helper processes load frameworks that
  are not signed by the same team, so without these three the app is signed,
  is accepted by Gatekeeper, and then dies on launch — which is a worse
  failure than being refused, because it looks like a bug in Archyne.

  These are the same defaults electron-builder applies when it signs an app
  itself; they are spelled out here because scripts/mac-adhoc-sign.mjs does
  the signing when no certificate is available, and codesign applies no
  entitlements unless it is handed a file.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
