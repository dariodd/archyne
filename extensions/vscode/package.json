{
  "name": "archyne",
  "displayName": "Archyne — visual editor for Mermaid",
  "description": "Edit Mermaid diagrams on a canvas, with two-way sync to the text. The file stays ordinary .mmd, and VS Code keeps owning it.",
  "version": "0.3.0",
  "publisher": "naxeris",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1014",
    "theme": "dark"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "mermaid",
    "diagram",
    "flowchart",
    "uml",
    "sequence-diagram"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dariodd/archyne.git",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/dariodd/archyne/issues"
  },
  "homepage": "https://github.com/dariodd/archyne/tree/main/extensions/vscode",
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "archyne.editor",
        "displayName": "Archyne",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "archyne.open",
        "title": "Open on the canvas",
        "category": "Archyne"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "archyne.open",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid"
        }
      ],
      "editor/title": [
        {
          "command": "archyne.open",
          "when": "resourceExtname == .mmd || resourceExtname == .mermaid",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "bundle": "node scripts/bundle-app.mjs",
    "compile": "tsc -p .",
    "build": "npm run version:sync && npm run bundle && npm run compile",
    "typecheck": "tsc -p . --noEmit",
    "package": "npm run build && vsce package --out archyne.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^1.1.1",
    "typescript": "~5.8.0"
  }
}
