{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  // The tests belong to the repository's runner, which has vitest; this
  // project does not, and compiling them would also put them in `out/`, which
  // is what the `.vsix` ships.
  "include": ["src"],
  "exclude": ["**/*.test.ts"]
}
