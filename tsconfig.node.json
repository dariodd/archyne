{
  // Node-side code: the MCP server, its smoke test, and the browser-driven
  // e2e script. These were never type-checked before — the root tsconfig
  // only includes `src`. Kept as a separate project because this code runs
  // under Node (tsx), not in the browser.
  //
  // `mcp/server.ts` imports from `src/model/`, so those files get checked
  // here too. That overlap is intentional and harmless: both projects are
  // noEmit, so it is pure verification.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node", "vite/client"]
  },
  "include": ["mcp", "tests", "desktop"]
}
